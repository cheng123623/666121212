<view class="container">
  <view class="card"><view class="od-status"><text class="tag tag-warn">{{order.statusText}}</text></view>
    <view class="od-no">订单号: {{order.number}}</view>
    <view class="od-time">下单时间: {{order.orderTime}}</view>
  </view>
  <view class="card"><view class="od-addr"><text class="od-label">收货地址</text>
    <view>{{order.consignee}} {{order.phone}}</view><view>{{order.address}}</view></view>
  </view>
  <view class="card"><view class="od-label">金额</view><view class="price">¥{{order.amount}}</view></view>
  <button class="cancel-btn" wx:if="{{order.status==1||order.status==2||order.status==3}}" bindtap="cancelOrder">取消订单</button>
</view>
