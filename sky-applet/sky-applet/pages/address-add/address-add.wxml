<view class="container"><view class="card">
  <view class="form-item"><text class="label">收货人</text><input value="{{form.consignee}}" placeholder="请输入收货人姓名" bindinput="onInput" data-field="consignee"/></view>
  <view class="form-item"><text class="label">手机号</text><input value="{{form.phone}}" placeholder="请输入手机号" bindinput="onInput" data-field="phone"/></view>
  <view class="form-item"><text class="label">性别</text><radio-group bindchange="onRadio"><label><radio value="1" checked="{{form.sex==='1'}}"/>男</label><label style="margin-left:24rpx"><radio value="0" checked="{{form.sex==='0'}}"/>女</label></radio-group></view>
  <view class="form-item"><text class="label">地址</text><input value="{{form.detail}}" placeholder="请输入详细地址" bindinput="onInput" data-field="detail"/></view>
  <view class="form-item"><text class="label">标签</text><picker range="{{labels}}" bindchange="onLabelChange"><text>{{form.label||'请选择'}}</text></picker></view>
  <view class="form-item"><text class="label">默认地址</text><switch checked="{{form.isDefault===1}}" bindchange="onDefaultChange"/></view>
</view>
<button class="btn-primary save-btn" bindtap="save">保存</button>
<button class="del-btn" wx:if="{{form.id}}" bindtap="deleteAddr">删除</button></view>
