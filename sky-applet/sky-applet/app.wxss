page{background:#f5f5f5;font-size:28rpx;color:#333}
.container{padding:20rpx}
.card{background:#fff;border-radius:16rpx;padding:24rpx;margin-bottom:20rpx}
.btn-primary{background:#ffc200;color:#333;border-radius:8rpx}
.price{color:#ff4d4f;font-size:32rpx;font-weight:bold}
.price::before{content:'¥';font-size:24rpx}
.tag{display:inline-block;padding:4rpx 12rpx;border-radius:4rpx;font-size:22rpx}
.tag-warn{background:#fff7e6;color:#fa8c16}
.tag-info{background:#e6f7ff;color:#1890ff}
.tag-success{background:#f6ffed;color:#52c41a}
